{
  "name": "Backend AI Labs (Java 21 + Gradle + JUnit 5)",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "features": {
    "ghcr.io/devcontainers/features/java:1": {
      "version": "21"
    },
    "ghcr.io/devcontainers/features/node:1": {
      "version": "22"
    }
  },
  "containerEnv": {
    "JAVA_HOME": "/usr/local/sdkman/candidates/java/current",
    "CHANGE_ADVISOR_BIND_ADDRESS": "0.0.0.0"
  },
  "postCreateCommand": "npm install -g @openai/codex @modelcontextprotocol/inspector",
  "customizations": {
    "vscode": {
      "extensions": [
        "redhat.java",
        "vscjava.vscode-java-debug",
        "vscjava.vscode-java-dependency",
        "vscjava.vscode-gradle",
        "richardwillis.vscode-spotless-gradle",
        "vmware.vscode-spring-boot",
        "openai.chatgpt",
        "darkstyle.codex-token-usage-for-enterprises",
        "vscjava.vscode-java-test"
      ]
    }
  },
  "forwardPorts": [
    8080,
    8092,
    9090
  ],
  "portsAttributes": {
    "8092": {
      "label": "Insurance sample"
    },
    "9090": {
      "label": "Change advisor"
    }
  }
}
